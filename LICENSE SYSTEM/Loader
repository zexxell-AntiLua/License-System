local Net = {}
do
	function Net.fetchWithRetry(url)
		local cleanUrl = url:match("^%s*(.-)%s*$") or url
		local sep = cleanUrl:find("%?") and "&" or "?"
		cleanUrl = cleanUrl .. sep .. "t=" .. _ostime() .. "_" .. math.random(1000, 9999)

		for attempt = 1, Config.Network.MaxRetries do
			local ok, body = _pcall(function() return HttpService:GetAsync(cleanUrl, true) end)
			if ok and body then return body end
			if attempt < Config.Network.MaxRetries then _taskwait(Config.Network.BackoffSeconds * attempt) end
		end
		return nil
	end

	function Net.postJson(url, encodedBody)
		if not url or url == "" then return false end
		local ok = _pcall(function() return HttpService:PostAsync(url, encodedBody, Enum.HttpContentType.ApplicationJson) end)
		return ok
	end
end

