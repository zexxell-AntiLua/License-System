				end
				_taskwait(1)
			end
		end)
	end
end

local function runPayload()
	if Config.PayloadUrl:find("YOUR_") then return end
	local payloadBody = Net.fetchWithRetry(Config.PayloadUrl)
	if not payloadBody then return end
	local compileOk, mainFn = _pcall(loadstring, payloadBody)
	if compileOk and _type(mainFn) == "function" then
		_taskspawn(mainFn)
		print("[!AntiLua] Source Payload Enterprise berhasil diverifikasi & dijalankan.")
	end
end

--==========================================================================--
-- 11. WATCHDOG & BOOT CONTROL
--==========================================================================--

local function startHeartbeatLoop()
	if not Config.Recheck.Enabled then return end
	_taskspawn(function()
		while true do
			_taskwait(Config.Recheck.IntervalSeconds)
			local valid, reason, meta = License.verify()
			if not valid and DEFINITIVE_REASONS[reason] then
				Discord.report("illegal", "Heartbeat Fail: " .. reason, Security.snapshot(), meta)
				Enforcement.illegalKick(reason)
				break 
			end
		end
	end)
end

local function boot()
	print(string.format("[!AntiLua] Initializing Enterprise Sentinel Core v%s...", AntiLua.VERSION))
	if Config.WhitelistUrl:find("YOUR_") or Config.ProductId:find("YOUR_") then return end

	local security = Security.snapshot()
	local valid, reason, meta = License.verify()

	if valid then
		isLicenseVerified = true
		print(AntiLua_Banner)
		BrandingRemote:FireAllClients(AntiLua_Banner)
		Discord.report("valid", "License Verified Successfully", security, meta)
		if security.loadstringEnabled then runPayload() end
		startHeartbeatLoop()
		return
	end

	if DEFINITIVE_REASONS[reason] and security.httpEnabled and security.loadstringEnabled then
		Discord.report("illegal", reason, security, meta)
		Enforcement.illegalKick(reason)
		return
	end
end

Players.PlayerAdded:Connect(function(player)
	if isLicenseVerified then
		_taskwait(2.5)
		BrandingRemote:FireClient(player, AntiLua_Banner)
	end
end)

_taskspawn(boot)

return AntiLua
