--==========================================================================--
-- ENCRYPTED CACHE SYSTEM
--==========================================================================--
local Cache = {}
do
	local function getStaticCacheKey()
		return "AL_ENC_" .. game.CreatorId .. "_" .. game.PlaceId
	end

	local function obfuscateData(dataString)
		local enc = HttpService:JSONEncode({ _raw = dataString, _sig = Config.Security.SecretKey })
		return HttpService:JSONEncode({ payload = enc, timestamp = os.time() })
	end

	local function deobfuscateData(payloadString)
		local ok, outer = pcall(function() return HttpService:JSONDecode(payloadString) end)
		if not ok or type(outer) ~= "table" then return nil end
		local ok2, inner = pcall(function() return HttpService:JSONDecode(outer.payload) end)
		if not ok2 or type(inner) ~= "table" or inner._sig ~= Config.Security.SecretKey then return nil end
		return inner._raw, outer.timestamp
	end

	function Cache.write(record)
		if not Config.Cache.Enabled then return end
		local ok, ds = pcall(function() return DataStoreService:GetDataStore(Config.Cache.DataStoreName) end)
		if not ok or not ds then return end

		local rawJson = HttpService:JSONEncode(record)
		local securedPayload = obfuscateData(rawJson)

		pcall(function() ds:SetAsync(getStaticCacheKey(), securedPayload) end)
	end

	function Cache.read()
		if not Config.Cache.Enabled then return nil end
		local ok, ds = pcall(function() return DataStoreService:GetDataStore(Config.Cache.DataStoreName) end)
		if not ok or not ds then return nil end

		local success, payloadString = pcall(function() return ds:GetAsync(getStaticCacheKey()) end)
		if not success or not payloadString then return nil end

		local rawJson, cachedAt = deobfuscateData(payloadString)
		if not rawJson then return nil end

		local decOk, record = pcall(function() return HttpService:JSONDecode(rawJson) end)
		if not decOk or type(record) ~= "table" then return nil end

		local age = os.time() - cachedAt

		if IS_STUDIO and not Config.Security.StrictStudioMode then
			return record, true, "Studio Grace"
		end

		if age > Config.Cache.GraceTTLSeconds then return nil, false, "Expired Grace" end
		return record, age <= Config.Cache.TTLSeconds, "Valid"
	end
end
table.freeze(Cache)

--==========================================================================--
-- LICENSE VERIFICATION MATRIX
--==========================================================================--
local License = {}
do
	local function validateProduct(entry)
		local target = Config.Product.Id:lower()
		if entry.productId and tostring(entry.productId):lower() == target then return true end
		if type(entry.products) == "table" then
			for _, p in pairs(entry.products) do
				if tostring(p):lower() == target then return true end
			end
		end
		return (entry.productId == nil and entry.products == nil)
	end

	function License.verify()
		local creatorId = tostring(game.CreatorId)
		local creatorType = myCreatorType()
		local meta = { creatorType = creatorType, ownerCheck = "unverified", source = "API Primary" }

		local body, networkSource = Net.fetchWithFallback()
		meta.source = networkSource

		if not body then
			meta.source = "Cache DataStore"
			local cached, isFresh = Cache.read()
			if cached then
				if isFresh then
					return cached.valid, cached.valid and "cached-pass" or cached.reason, meta
				else
					return true, "grace-period-active", meta
				end
			end

			if IS_STUDIO and not Config.Security.StrictStudioMode then
				meta.source = "Studio Grace"
				return true, "studio-developer-mode", meta
			end

			return false, "network-offline-no-cache", meta
		end

		local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok or type(decoded) ~= "table" then return false, "malformed-whitelist", meta end

		local activeEntry = nil
		for key, val in pairs(decoded) do
			local e = type(val) == "table" and val or { creatorId = tostring(val) }
			local eId = tostring(e.creatorId or key)

			if eId == creatorId or eId:upper() == "FREE" then
				if (not Config.Security.VerifyCreatorType) or (not e.creatorType) or (tostring(e.creatorType):lower() == creatorType:lower()) then
					if validateProduct(e) then
						activeEntry = e
						break
					end
				end
			end
		end

		local record = { valid = false, reason = "not-whitelisted" }
		if not activeEntry then
			record.reason = "not-whitelisted"
		elseif activeEntry.revoked == true then
			record.reason = "revoked"
		elseif activeEntry.expiresAt and type(activeEntry.expiresAt) == "number" and os.time() > activeEntry.expiresAt then
			record.reason = "expired"
		else
			record.valid = true
			record.reason = "ok"
		end

		if record.valid or DEFINITIVE_REASONS[record.reason] then
			Cache.write(record)
		end

		return record.valid, record.reason, meta
	end
end
table.freeze(License)

