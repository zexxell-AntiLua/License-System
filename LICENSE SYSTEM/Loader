-- 5. DATASTORE CACHE SYSTEM (WITH HMAC SIGNATURE)
--==========================================================================--

local Cache = {}
do
	local store
	local function getStore()
		if store then return store end
		local ok, ds = _pcall(function() return DataStoreService:GetDataStore(Config.Cache.DataStoreName) end)
		if ok then store = ds end
		return store
	end

	local function cacheKey()
		return "lic_v2_" .. _tostring(game.CreatorId) .. "_" .. myCreatorType() .. "_" .. Config.ProductId:gsub("%s+", "")
	end

	function Cache.write(record)
		if not Config.Cache.Enabled then return end
		local ds = getStore()
		if not ds then return end
		record.cachedAt = _ostime()
		record.sig = Crypto.generateSignature(game.CreatorId, Config.ProductId, Config.SecretSalt)
		local ok, payload = _pcall(function() return HttpService:JSONEncode(record) end)
		if ok and payload then _pcall(function() ds:SetAsync(cacheKey(), payload) end) end
	end

	function Cache.read()
		if not Config.Cache.Enabled then return nil end
		local ds = getStore()
		if not ds then return nil end
		local ok, raw = _pcall(function() return ds:GetAsync(cacheKey()) end)
		if not ok or not raw then return nil end
		local decOk, record = _pcall(function() return HttpService:JSONDecode(raw) end)
		if not decOk or _type(record) ~= "table" or not record.cachedAt then return nil end

		-- Verifikasi integritas data cache dengan Signature
		local expectedSig = Crypto.generateSignature(game.CreatorId, Config.ProductId, Config.SecretSalt)
		if record.sig ~= expectedSig then return nil end -- Cache palsu diabaikan

		local age = _ostime() - record.cachedAt
		if age > Config.Cache.GraceTTLSeconds then return nil end
		return record, age <= Config.Cache.TTLSeconds
	end
end

