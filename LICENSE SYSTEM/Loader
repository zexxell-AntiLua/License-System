--==========================================================================--
-- WATCHDOG DUAL-THREAD
--==========================================================================--
local function startDualWatchdog()
	if not Config.Recheck.Enabled then return end

	task.spawn(function()
		while task.wait(Config.Recheck.IntervalSeconds) do
			State.WatchdogA = os.clock()
			local valid, reason, meta = License.verify()

			if not valid and DEFINITIVE_REASONS[reason] then
				Discord.report("illegal", "Watchdog Revoke: " .. reason, Security.snapshot(), meta)
				Enforcement.illegalKick(reason)
				break 
			end

			if os.clock() - State.WatchdogB > (Config.Recheck.IntervalSeconds * 2.5) then
				Enforcement.illegalKick("tamper-detected (Thread Desync)")
				break
			end
		end
	end)

	task.spawn(function()
		while task.wait(Config.Recheck.IntervalSeconds + 5) do
			State.WatchdogB = os.clock()
			if os.clock() - State.WatchdogA > (Config.Recheck.IntervalSeconds * 2.5) then
				Enforcement.illegalKick("tamper-detected (Core Terminated)")
				break
			end
		end
	end)
end

--==========================================================================--
-- BOOTSTRAP CONTROL SYSTEM
--==========================================================================--
local function runPayload()
	if Config.Network.PayloadUrl:find("YOUR_") then return end
	local payloadBody, _ = Net.fetchWithFallback()
	if not payloadBody then return end
	local compileOk, mainFn = pcall(loadstring, payloadBody)
	if compileOk and type(mainFn) == "function" then
		task.spawn(mainFn)
		print("[!AntiLua] Source Payload berhasil dijalankan.")
	end
end

local function boot()
	print(string.format("[!AntiLua] Running Engine Core v%s Enterprise...", AntiLua.VERSION))
	if Config.Network.PrimaryUrl:find("YOUR_") or Config.Product.Id:find("YOUR_") then return end

	local security = Security.snapshot()
	local valid, reason, meta = License.verify()

	if valid or reason == "studio-developer-mode" or reason == "grace-period-active" then
		State.IsVerified = true
		print(AntiLua_Banner)
		BrandingRemote:FireAllClients(AntiLua_Banner)
		Discord.report("verified", reason, security, meta)
		if security.loadstringEnabled then runPayload() end
		startDualWatchdog()
		return
	end

	if DEFINITIVE_REASONS[reason] and security.httpEnabled and security.loadstringEnabled then
		Discord.report("illegal", reason, security, meta)
		Enforcement.illegalKick(reason)
		return
	end

	-- Safe Mode / Offline Safe Protocol
	State.SafeMode = true
	warn("[!AntiLua SafeMode] Gagal memverifikasi lisensi. Fitur premium dinonaktifkan.")
	Discord.report("warning", "SafeMode Active: " .. reason, security, meta)
end

Players.PlayerAdded:Connect(function(player)
	if State.IsVerified then
		task.wait(2.5)
		BrandingRemote:FireClient(player, AntiLua_Banner)
	end
end)

task.spawn(boot)

