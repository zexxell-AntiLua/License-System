do
	function Security.isHttpEnabled()
		local ok, enabled = pcall(function() return HttpService.HttpEnabled end)
		return ok and enabled == true
	end

	function Security.isLoadstringEnabled()
		local ok, fnOrErr = pcall(function() return loadstring("return true") end)
		if not ok or type(fnOrErr) ~= "function" then return false end
		local runOk, result = pcall(fnOrErr)
		return runOk and result == true
	end

	function Security.snapshot()
		return { httpEnabled = Security.isHttpEnabled(), loadstringEnabled = Security.isLoadstringEnabled() }
	end
end
