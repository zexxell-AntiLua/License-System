--==========================================================================--
-- NETWORK ENGINE & CIRCUIT BREAKER
--==========================================================================--
local Net = {}
do
	function Net.fetchWithRetry(url)
		if not url or url == "" or url:find("YOUR_") then return nil end
		local cleanUrl = url:match("^%s*(.-)%s*$")
		local sep = cleanUrl:find("%?") and "&" or "?"

		for attempt = 1, Config.Network.MaxRetries do
			local cacheBuster = cleanUrl .. sep .. "cb=" .. tostring(os.clock() + math.random(1000,9999))
			local ok, body = pcall(function() return HttpService:GetAsync(cacheBuster, true) end)
			if ok and body then return body end
			if attempt < Config.Network.MaxRetries then task.wait(Config.Network.BackoffSeconds * attempt) end
		end
		return nil
	end

	function Net.postJson(url, encodedBody)
		if not url or url == "" or url:find("YOUR_") then return false end
		local ok, _ = pcall(function() return HttpService:PostAsync(url, encodedBody, Enum.HttpContentType.ApplicationJson) end)
		return ok
	end

	function Net.fetchWithFallback()
		local data = Net.fetchWithRetry(Config.Network.PrimaryUrl)
		if data then return data, "API Primary" end
		if Config.Network.FallbackUrl and Config.Network.FallbackUrl ~= "" then
			data = Net.fetchWithRetry(Config.Network.FallbackUrl)
			if data then return data, "API Backup Mirror" end
		end
		return nil, "Offline"
	end
end
table.freeze(Net)

