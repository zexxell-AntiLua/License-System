local License = {}
do
	function License.verify()
		local creatorId = _tostring(game.CreatorId)
		local creatorType = myCreatorType()
		local meta = { creatorType = creatorType, ownerCheck = "unverified" }

		-- 1. Anti-Hook & Environment Check
		local envOk, envReason = Integrity.checkEnvironment()
		if not envOk then
			return false, "environment-tampered", meta
		end

		-- 2. Anti-Fake Response Canary Trap Check
		local canaryPassed = Integrity.runCanaryHoneypot()
		if not canaryPassed then
			return false, "canary-trap-triggered", meta
		end

		-- 3. Fetch Whitelist dari GitHub
		local body = Net.fetchWithRetry(Config.WhitelistUrl)
		if not body then
			local cached, isFresh = Cache.read()
			if cached then return cached.valid, cached.valid and "cached-pass" or "cached-fail", meta end
			return false, "whitelist-unreachable", meta
		end

		local decOk, entries = _pcall(function() return HttpService:JSONDecode(body) end)
		if not decOk or _type(entries) ~= "table" then
			return false, "malformed-whitelist", meta
		end

		local entry = nil
		for _, e in ipairs(entries) do
			if _type(e) == "table" and e.creatorId then
				local idMatches = (_tostring(e.creatorId) == creatorId) or (_tostring(e.creatorId):upper() == "FREE")
				local typeMatches = (not Config.Ownership.VerifyCreatorType) or (e.creatorType == nil) or (_tostring(e.creatorType):lower() == creatorType:lower())

				local productMatches = false
				local targetProd = Config.ProductId:lower()

				if e.productId == nil and e.products == nil then
					productMatches = true 
				elseif e.productId ~= nil and _tostring(e.productId):lower() == targetProd then
					productMatches = true
				elseif _type(e.products) == "table" then
					for _, p in pairs(e.products) do
						if _tostring(p):lower() == targetProd then productMatches = true; break end
					end
				end

				if idMatches and typeMatches and productMatches then entry = e; break end
			end
		end

		local record = { valid = false, reason = "not-whitelisted" }
		if not entry then
			record.reason = "not-whitelisted"
		elseif entry.revoked == true then
			record.reason = "revoked"
		elseif entry.expiresAt and _type(entry.expiresAt) == "number" and _ostime() > entry.expiresAt then
			record.reason = "expired"
		else
			-- 4. SIGNATURE VALIDATION (Mencegah Manipulasi JSON Whitelist)
			if entry.signature then
				local expectedSig = Crypto.generateSignature(creatorId, Config.ProductId, Config.SecretSalt)
				if entry.signature ~= expectedSig then
					record.reason = "hash-mismatch"
				else
					record.valid = true
					record.reason = "ok"
				end
			else
				-- Jika signature tidak dipasang di whitelist JSON, fallback ke verifikasi standar
				record.valid = true
				record.reason = "ok"
			end
		end

		Cache.write(record)
		return record.valid, record.reason, meta
	end
end

