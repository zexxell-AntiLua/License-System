-- 1. CRYPTOGRAPHIC SIGNATURE ENGINE (FNV-1a Salted Hashing)
--==========================================================================--

local Crypto = {}
function Crypto.hash(inputStr)
	local hash = 2166136261
	local str = _tostring(inputStr)
	for i = 1, #str do
		local byte = string.byte(str, i)
		hash = bit32.bxor(hash, byte)
		hash = bit32.arshift(hash * 16777619, 0)
	end
	return string.format("%08x", hash)
end

function Crypto.generateSignature(creatorId, productId, salt)
	return Crypto.hash(_tostring(creatorId) .. ":" .. _tostring(productId):lower() .. ":" .. _tostring(salt))
end

