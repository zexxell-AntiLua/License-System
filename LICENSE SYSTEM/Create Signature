def generate_signature(creator_id, product_id, salt):
    clean_creator = str(creator_id).replace(" ", "")
    clean_product = str(product_id).lower().replace(" ", "")
    clean_salt = str(salt).replace(" ", "")
    
    raw_str = f"{clean_creator}:{clean_product}:{clean_salt}"
    
    hash_val = 2166136261
    for char in raw_str.encode('utf-8'):
        hash_val ^= char
        low = hash_val & 0xFFFF
        high = (hash_val >> 16) & 0xFFFF
        p1 = (low * 16777619) & 0xFFFFFFFF
        p2 = (high * 16777619) & 0xFFFF
        hash_val = (p1 + (p2 << 16)) & 0xFFFFFFFF
        
    return f"{hash_val:08x}"

# Contoh penggunaan:
sig = generate_signature("12345678", "YOUR_PRODUCT_NAME_HERE", "ANTILUA_ULTRA_SECRET_SALT_2026_#99")
print("Signature:", sig)
